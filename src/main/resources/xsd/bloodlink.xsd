<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://bloodlink.example.com/soap"
           targetNamespace="http://bloodlink.example.com/soap"
           elementFormDefault="qualified">

    <!-- 1. how much blood of a group is in the bank? -->
    <xs:element name="CheckStockRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="bloodGroup" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CheckStockResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="bloodGroup" type="xs:string"/>
                <xs:element name="unitsAvailable" type="xs:int"/>
                <xs:element name="level" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- 2. can this donor give blood today? -->
    <xs:element name="CheckEligibilityRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="donorId" type="xs:long"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CheckEligibilityResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="donorId" type="xs:long"/>
                <xs:element name="donorName" type="xs:string"/>
                <xs:element name="eligible" type="xs:boolean"/>
                <xs:element name="message" type="xs:string"/>
                <xs:element name="nextEligibleDate" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
